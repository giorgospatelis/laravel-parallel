# PHPBench Environment Configuration
# This file sets up the environment specifically for benchmarking

# CRITICAL: Disable mock worker pools - benchmarks MUST use real parallel execution
PARALLEL_USE_MOCK_POOLS=false

# Disable events during benchmarks - they add overhead and skew measurements
PARALLEL_EVENTS_ENABLED=false

# Disable logging during benchmarks - logging impacts performance
PARALLEL_LOGGING_ENABLED=false

# Disable Horizon integration during benchmarks
PARALLEL_HORIZON_ENABLED=false

# Set reasonable defaults for benchmarking
PARALLEL_WORKERS=
PARALLEL_TIMEOUT=60
PARALLEL_MAX_WORKERS=128
PARALLEL_MAX_TASKS=10000
