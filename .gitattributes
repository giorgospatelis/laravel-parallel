# ============================================
# Laravel Package .gitattributes
# ============================================
# This file configures Git attributes for proper
# line ending handling, diff display, and export
# optimization for package distribution.
# ============================================

# ============================================
# Auto-detect Text Files
# ============================================
# Automatically normalize line endings for all text files
# Git will handle CRLF/LF conversion based on platform
* text=auto

# ============================================
# Source Code - Enforce LF Line Endings
# ============================================
# All source code should use LF (Unix-style) line endings
# even on Windows to ensure consistency across platforms
*.php text eol=lf diff=php
*.js text eol=lf
*.ts text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf
*.css text eol=lf diff=css
*.scss text eol=lf
*.sass text eol=lf
*.less text eol=lf
*.styl text eol=lf
*.vue text eol=lf
*.blade.php text eol=lf diff=html

# ============================================
# Configuration & Data Files
# ============================================
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.env text eol=lf
*.conf text eol=lf
*.config text eol=lf

# ============================================
# Documentation Files
# ============================================
*.md text eol=lf diff=markdown
*.markdown text eol=lf diff=markdown
*.txt text eol=lf
*.rst text eol=lf
*.adoc text eol=lf
LICENSE text eol=lf
README text eol=lf
CHANGELOG text eol=lf
CONTRIBUTING text eol=lf
AUTHORS text eol=lf

# ============================================
# Shell Scripts & CLI
# ============================================
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.fish text eol=lf

# ============================================
# Windows-Specific Files (Use CRLF)
# ============================================
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ============================================
# SQL & Database Files
# ============================================
*.sql text eol=lf

# ============================================
# Binary Files
# ============================================
# Explicitly mark binary files to prevent
# Git from attempting text operations on them
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.webp binary
*.avif binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.tgz binary
*.bz2 binary
*.7z binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.mo binary

# ============================================
# EXPORT-IGNORE: Exclude from Distribution
# ============================================
# These files/directories are excluded when creating
# a distribution archive (e.g., via composer install)
# This significantly reduces package size in production

# Version Control
/.git export-ignore
/.github export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore

# Composer Lock File
# Keep in repo for consistent dev environment, but exclude from distribution
# Production users should install based on composer.json constraints
composer.lock export-ignore

# CI/CD Configuration
/.travis.yml export-ignore
/.circleci export-ignore
/.gitlab-ci.yml export-ignore
/azure-pipelines.yml export-ignore
/.github/workflows export-ignore

# Testing
/tests export-ignore
/phpunit.xml export-ignore
/phpunit.xml.dist export-ignore
/.phpunit.cache export-ignore
/.phpunit.result.cache export-ignore
/pest.php export-ignore

# Code Quality Tools
/phpstan.neon export-ignore
/phpstan.neon.dist export-ignore
/phpstan-baseline.neon export-ignore
/.phpstan.cache export-ignore
/.php-cs-fixer.php export-ignore
/.php-cs-fixer.dist.php export-ignore
/.php_cs export-ignore
/.php_cs.dist export-ignore
/pint.json export-ignore
/.pint.cache export-ignore
/psalm.xml export-ignore
/psalm.xml.dist export-ignore
/.psalm export-ignore

# Editor Configuration
/.editorconfig export-ignore
/.vscode export-ignore
/.idea export-ignore
/.fleet export-ignore

# Documentation & Meta Files
/CHANGELOG.md export-ignore
/CONTRIBUTING.md export-ignore
/CONTRIBUTORS.md export-ignore
/CODE_OF_CONDUCT.md export-ignore
/SECURITY.md export-ignore
/UPGRADING.md export-ignore
/CLAUDE.md export-ignore
/docs export-ignore
/art export-ignore
/examples export-ignore
/.mcp.json export-ignore
/.claude export-ignore

# Build & Development Tools
/docker-compose.yml export-ignore
/Dockerfile export-ignore
/.dockerignore export-ignore
/Makefile export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/yarn.lock export-ignore
/pnpm-lock.yaml export-ignore
/webpack.mix.js export-ignore
/vite.config.js export-ignore
/tsconfig.json export-ignore
/.eslintrc export-ignore
/.prettierrc export-ignore
/.stylelintrc export-ignore
/node_modules export-ignore

# Workbench & Sandbox (for package development)
/workbench export-ignore
/sandbox export-ignore

# ============================================
# Language-Specific Diff Drivers
# ============================================
# Tell Git how to generate better diffs for
# specific file types to improve code review

# PHP
*.php diff=php

# HTML (includes Blade templates)
*.html diff=html
*.blade.php diff=html

# CSS
*.css diff=css

# Markdown
*.md diff=markdown

# ============================================
# Merge Strategies
# ============================================
# Specify merge strategies for specific files

# Always use "ours" strategy for composer.lock
# (regenerate instead of merging)
composer.lock merge=binary

# Always use "ours" for package-lock
package-lock.json merge=binary
