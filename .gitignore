# ============================================
# Dependencies
# ============================================
# Vendor directory - contains all Composer dependencies
# Never commit this as it's generated from composer.json/lock
/vendor/

# composer.lock - KEEP THIS COMMITTED for libraries!
# For libraries/packages, composer.lock should be committed
# to ensure consistent development environment across contributors.
# It's excluded from distribution via .gitattributes export-ignore.
# Production users install based on composer.json constraints, not the lock.
# Uncomment the line below ONLY if this becomes an application:
# composer.lock

# ============================================
# Build Artifacts & Caches
# ============================================
# PHPUnit cache files - generated during test runs
/.phpunit.cache
.phpunit.result.cache

# PHPStan cache - static analysis cache
/.phpstan.cache

# PHP CS Fixer cache - code style fixer cache
.php-cs-fixer.cache
.php_cs.cache

# Laravel Pint cache - Laravel's code style tool
.pint.cache

# Pest cache - testing framework cache
.pest.cache

# Build directory - often used for compiled assets
/build/
/dist/

# Coverage reports - generated by test coverage tools
/coverage/
/coverage-html/
/.phpunit.result.cache
/clover.xml
/coverage.xml
*.coverage

# ============================================
# Operating System Files
# ============================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# ============================================
# IDE & Editor Files
# ============================================
# PHPStorm / IntelliJ IDEA
/.idea/
*.iml
*.ipr
*.iws

# Visual Studio Code
/.vscode/
*.code-workspace

# Sublime Text
*.sublime-project
*.sublime-workspace

# NetBeans
/nbproject/
*.nbm

# Eclipse
/.buildpath
/.project
/.settings/

# Vim
*.swp
*.swo
*~
.*.sw[a-z]
.netrwhist

# Emacs
*~
\#*\#
.\#*

# Fleet
/.fleet/

# ============================================
# Laravel Specific (if applicable)
# ============================================
# Environment files - contain sensitive data
# and local configuration
.env
.env.*
!.env.example

# Laravel Mix / Vite (if package has frontend assets)
/node_modules/
npm-debug.log
yarn-error.log
/public/hot
/public/storage
/storage/*.key

# ============================================
# Testing & Development
# ============================================
# Custom PHPUnit configuration
# (phpunit.xml.dist should be committed)
/phpunit.xml

# Test output
/tests/temp/
/tests/.cache/
/.test-results/

# Pest parallel temporary files
/.parallel/

# ============================================
# Documentation Generation
# ============================================
# Generated documentation
/docs/_site/
/.phpdoc/

# ============================================
# Package Manager Files
# ============================================
# Composer binaries
composer.phar

# NPM/Yarn (if package has frontend components)
package-lock.json
yarn.lock
pnpm-lock.yaml

# ============================================
# Logs
# ============================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================
# Temporary Files
# ============================================
*.tmp
*.temp
*.cache
*.bak
*.swp

# ============================================
# Security & Credentials
# ============================================
# Never commit authentication or API keys
auth.json
.env
*.pem
*.key
*.p12
*.pfx
secrets.yml

.claude/
CLAUDE.md
.mcp.json
