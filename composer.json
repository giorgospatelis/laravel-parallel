{
    "name": "laravel-parallel/laravel-parallel",
    "description": "Simple parallel processing for Laravel - Powered by AMPHP with automatic CPU detection.",
    "keywords": ["laravel", "parallel", "async", "concurrent", "amphp", "multi-processing"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Giorgos Patelis",
            "email": "giorgospatelis@outlook.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/contracts": "^11.0|^12.0",
        "amphp/parallel": "^2.3",
        "laravel/serializable-closure": "^2.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpbench/phpbench": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "LaravelParallel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelParallel\\Tests\\": "tests/",
            "LaravelParallel\\Benchmarks\\": "benchmarks/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --display-errors --display-warnings --display-deprecations",
        "test:coverage": "vendor/bin/pest --coverage --min=80",
        "test:coverage-html": "vendor/bin/pest --coverage-html coverage-html",
        "test:coverage-clover": "vendor/bin/pest --coverage-clover=clover.xml",
        "phpstan": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "format:test": "vendor/bin/pint --test",
        "bench": "vendor/bin/phpbench run benchmarks/CoreParallelBench.php --filter=benchSetupOverhead --iterations=3 --revs=3 --report=aggregate",
        "bench:quick": "vendor/bin/phpbench run benchmarks/CoreParallelBench.php --filter=benchSetupOverhead --iterations=1 --revs=1 --report=default",
        "bench:core": "vendor/bin/phpbench run benchmarks/CoreParallelBench.php --iterations=3 --revs=5 --warmup=1 --report=aggregate --progress=dots",
        "bench:scaling": "vendor/bin/phpbench run benchmarks/ScalingBench.php --iterations=3 --revs=5 --warmup=1 --report=aggregate --progress=dots",
        "bench:full": "vendor/bin/phpbench run --iterations=10 --revs=50 --warmup=2 --report=aggregate --progress=dots",
        "bench:baseline": "vendor/bin/phpbench run --iterations=3 --revs=5 --tag=baseline --store",
        "bench:compare": "vendor/bin/phpbench run --iterations=3 --revs=5 --ref=baseline --report=aggregate",
        "bench:report": "vendor/bin/phpbench run --iterations=3 --revs=5 --report=html --output=html",
        "bench:aggregate": "vendor/bin/phpbench run --report=aggregate",
        "bench:env": "vendor/bin/phpbench run --report=env"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist"
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelParallel\\ParallelServiceProvider"
            ],
            "aliases": {
                "Parallel": "LaravelParallel\\Facades\\Parallel"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
