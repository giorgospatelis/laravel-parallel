		-
			message: '#^Access to an undefined property PHPUnit\\Framework\\TestCase\:\:\$cpuDetector\.$#'
			identifier: property.notFound
			count: 1
			path: tests/Unit/Workers/WorkerPoolFactoryTest.php

		-
