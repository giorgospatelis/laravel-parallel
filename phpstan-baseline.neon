		-
			message: '#^Access to an undefined property PHPUnit\\Framework\\TestCase\:\:\$successfulResult2\.$#'
			identifier: property.notFound
			count: 8
			path: tests/Unit/Results/ResultCollectionTest.php

		-
			message: '#^Cannot call method getMessage\(\) on Throwable\|null\.$#'
			identifier: method.nonObject
			count: 1
			path: tests/Unit/Results/ResultCollectionTest.php

		-
			message: '#^Access to an undefined property PHPUnit\\Framework\\TestCase\:\:\$validator\.$#'
			identifier: property.notFound
			count: 20
