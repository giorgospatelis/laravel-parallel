includes:
    - ./vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: max

    paths:
        - src

    excludePaths:
        - tests/Pest.php
        - tests/**/*Test.php
        - src/Console/*

    # Ignore errors
    ignoreErrors:
        # Pest testing framework
        - '#Function (test|it|describe|beforeEach|afterEach)\(\) invoked with \d+ parameters?, 0 required\.#'

        # Serializable closures - expected behavior for parallel processing
        - '#Closure invoked with \d+ parameters?, 0 required\.#'
        - '#Parameter \#\d+ \$.*? of method .*?::.*?\(\) expects Closure, Laravel\\SerializableClosure\\SerializableClosure given\.#'

        # amphp/parallel specific - dynamic parallel execution patterns
        - '#Call to method submit\(\) on an unknown class Amp\\Parallel\\Worker\\Worker\.#'
        - '#Parameter .* of method .* expects callable\(\): mixed, Closure given\.#'

        # Config files are ALLOWED to use env() - this is Laravel's standard pattern
        # PHPStan/Larastan incorrectly flags this as an error
        # See: https://laravel.com/docs/11.x/configuration#environment-configuration
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/*

        # Orchestra Canvas internal error - not our code
        - '#Internal error: Orchestra\\Canvas\\Console\\MigrateMakeCommand#'


    # Enable stricter analysis
    treatPhpDocTypesAsCertain: true
    reportUnmatchedIgnoredErrors: false
    checkExplicitMixedMissingReturn: true
    checkFunctionNameCase: true
    checkInternalClassCaseSensitivity: true

    # Unused variable/parameter detection
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    checkUninitializedProperties: true
    checkDynamicProperties: true

    # PHP 8.2+ features
    polluteScopeWithLoopInitialAssignments: false
    polluteScopeWithAlwaysIterableForeach: false

    # Parallel analysis optimization
    parallel:
        jobSize: 20
        maximumNumberOfProcesses: 4
        minimumNumberOfJobsPerProcess: 2
